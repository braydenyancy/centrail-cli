{
  "name": "centrail",
  "version": "0.9.0",
  "description": "Sync your local AI coding-agent usage (Claude Code, GitHub Copilot CLI, Codex, Gemini CLI, Pi) to centrail.org.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "centrail": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@centrail/parsers": "*",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/braydenyancy/centrail-cli.git",
    "directory": "packages/cli"
  }
}
